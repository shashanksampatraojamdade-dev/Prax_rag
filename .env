# --- Application ---
APP_ENV=development
LOG_LEVEL=INFO
API_PREFIX=/api/v1

# --- Vertex AI ---
VERTEX_PROJECT=pid-gousenad-enen-gpaig-01
VERTEX_LOCATION=global
LLM_MODEL=gemini-3.8-flash
EMBEDDING_MODEL=text-embedding-005
EMBEDDING_DIM=768

# --- Postgres / pgvector ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=praxrag
POSTGRES_USER=praxrag
POSTGRES_PASSWORD=praxrag

# --- RAG parameters ---
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_TOP_K=5
