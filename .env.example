# --- Application ---
APP_ENV=development
LOG_LEVEL=INFO
API_PREFIX=/api/v1

# --- Vertex AI ---
VERTEX_PROJECT=pid-gousenad-enen-gpaig-01
VERTEX_LOCATION=global
LLM_MODEL=gemini-3.8-flash
EMBEDDING_MODEL=text-embedding-005
EMBEDDING_DIM=768

# --- Postgres / pgvector ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=praxrag
POSTGRES_USER=praxrag
POSTGRES_PASSWORD=praxrag

# --- RAG parameters ---
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_TOP_K=5

# --- Hybrid retrieval + answer gating (prax_re SDK) ---
ENABLE_HYBRID_RETRIEVAL=true
ENABLE_KEYWORD_RETRIEVAL=true
RETRIEVAL_CANDIDATE_K=10
RRF_K=60
# Minimum confidence (0-1) to answer; below this the engine declines ("I don't
# know") instead of hallucinating. Set to 0 to always answer.
IDK_THRESHOLD=0.5
# Contextual compression: trim retrieved chunks to only the query-relevant
# sentences before answering (saves tokens, boosts precision).
ENABLE_COMPRESSION=true
COMPRESSION_MAX_SENTENCES=4
COMPRESSION_MIN_OVERLAP=0.1

# --- Knowledge base / ingestion quality ---
CHUNK_STRATEGY=semantic
SEMANTIC_BREAKPOINT_PERCENTILE=90.0
ENABLE_OCR=true
ENABLE_PARENT_CHILD=true
PARENT_CHUNK_SIZE=2000
ENABLE_DEDUPLICATION=true
ENABLE_VERSIONING=true
ENABLE_INCREMENTAL=true
ENABLE_ADAPTIVE_CHUNKING=true

# --- Query understanding & transformation (prax_qt SDK) ---
ENABLE_QUERY_TRANSFORMATION=false
ENABLE_QUERY_REWRITING=true
ENABLE_QUERY_EXPANSION=true
QUERY_EXPANSION_TERMS=6
ENABLE_MULTI_QUERY=true
MULTI_QUERY_COUNT=3
ENABLE_HYDE=true
ENABLE_QUERY_CLASSIFICATION=true
ENABLE_QUERY_ROUTING=true
QUERY_ROUTES=knowledge_base
ENABLE_INTENT_DETECTION=true
ENABLE_MULTI_HOP=true
MAX_HOPS=3
# Performance: one structured LLM call for all techniques (fast path); the
# per-technique fallback runs independent techniques concurrently.
QUERY_SINGLE_CALL=true
QUERY_MAX_WORKERS=8
